---
layout: default
---
{% if page.cv_pdf %}
  {% if page.cv_pdf contains '://' %}
    {% assign cv_pdf_url = page.cv_pdf %}
  {% else %}
    {% assign cv_pdf_url = page.cv_pdf | prepend: 'assets/pdf/' | relative_url %}
  {% endif %}
{% endif %}

<div class="post">
  <header class="post-header">
    <h1 style="text-align: left !important; display: flex; justify-content: space-between; align-items: center;">
      <span>{{ page.title }}</span>
      {% if cv_pdf_url %}
        <a
          href="{{ cv_pdf_url }}"
          target="_blank"
          rel="noopener noreferrer"
        >
          <i class="fa-solid fa-file-pdf"></i>
        </a>
      {% endif %}
    </h1>
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  {% if page.cv_reader and cv_pdf_url %}
    <article class="mt-4">
      <iframe
        src="{{ cv_pdf_url }}"
        title="CV PDF"
        style="width: 100%; min-height: 85vh; border: 1px solid var(--global-divider-color); border-radius: 8px;"
      ></iframe>
    </article>
  {% endif %}
</div>
